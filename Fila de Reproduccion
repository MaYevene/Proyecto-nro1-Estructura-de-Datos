 #include "Reproductor.h"

 /**
  * @brief
  * 
  * @param albumes
  * @param ciclos
  */

void Historial(Album *albumes);

void Fila_de_Reproduccion(Album *albumes)
{
    if(albumes->cont<albumes->cancion[albumes->elec_al][albumes->Eleccion].duracion_s)
    {
        albumes->cont++;
        if(albumes->cont==albumes->cancion[albumes->elec_al][albumes->Eleccion].duracion_s)
        {
            printf("=========================================\n");
            Historial(albumes);
            printf("\t>%s\n",albumes->cancion[albumes->elec_al][albumes->Eleccion].titulo);
            albumes->Eleccion--;
            albumes->cont=0;
        }
        if(albumes->Eleccion<0)
        {
            printf("=========================================\n\n");
            albumes->ciclo=false;
        }
    }
    return;
}

/**
 * @brief
 * 
 * @param albumes
 */

void Historial(Album *albumes)
{
    albumes->cancion[albumes->elec_al][albumes->Eleccion].past.Cant_Re++;
    albumes->cancion[albumes->elec_al][albumes->Eleccion].past.reproducido=true;
    albumes->cancion[albumes->elec_al][albumes->Eleccion].past.orden++;
    if(albumes->Eleccion+1<Cant_So)
    {
        albumes->cancion[albumes->elec_al][albumes->Eleccion].past.orden=+albumes->cancion[albumes->elec_al][albumes->Eleccion+1].past.orden;
    }
}
